{
  "name": "Find My Tab",
  "version": "1.2.0",
  "description": "Jump to the right tab immediately, even when you have 100 tabs open.",
  "permissions": [
    "tabs"
  ],
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "windows": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  },
  "action": {
    "default_title": "Find My Tab",
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  }
}
